# Copy to .env.local and fill in from the Supabase dashboard (Project Settings > API).
# Never commit real values.

# Public: safe in the browser, protected by row-level security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only: bypasses row-level security. Use only in trusted server code
# (cron jobs, admin scripts). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection string for the Supabase CLI and migrations.
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
